SERVER_PORT=8080
POSTGRES_DB=bukovina_platform
POSTGRES_USER=bukovina_app
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=15432
DB_URL=jdbc:postgresql://127.0.0.1:15432/bukovina_platform
DB_USERNAME=bukovina_app
DB_PASSWORD=
ADMIN_JWT_ISSUER=nisztor-bukovina-platform
# Base64-encoded, randomly generated 32-byte secret. Never commit a real value.
ADMIN_JWT_SECRET=
ADMIN_JWT_ACCESS_TOKEN_TTL=PT30M
# Maximum failed or successful login attempts per IP address and email during the refill period.
ADMIN_LOGIN_RATE_LIMIT_CAPACITY=5
ADMIN_LOGIN_RATE_LIMIT_REFILL_PERIOD=PT1M
# Used only when the backend starts with SPRING_PROFILES_ACTIVE=dev.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Nisztor-Bukovina Platform
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_READ_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000
NOTIFICATIONS_ENABLED=false
BOOKING_NOTIFICATION_MAX_ATTEMPTS=5
BOOKING_NOTIFICATION_RETRY_INITIAL_DELAY_SECONDS=60
BOOKING_NOTIFICATION_WORKER_DELAY=PT10S
# Base64-encoded, randomly generated 32-byte AES key. Never commit a real value.
BOOKING_NOTIFICATION_TOKEN_ENCRYPTION_KEY=
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_ADMIN_BASE_URL=http://localhost:5173
